{
  "name": "shoso-books",
  "productName": "SHOSO Books",
  "version": "1.7.0",
  "description": "SHOSO Books - קורא ספרים שולחני לווינדוס (Windows only) - חלופה ל-Readera",
  "author": "SHOSO",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "preview:web": "vite preview --host 0.0.0.0 --port 4173",
    "build:web": "vite build",
    "start:app": "npm run build:web && electron .",
    "app": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build:web && electron-builder --win nsis portable",
    "dist:portable": "npm run build:web && electron-builder --win portable",
    "build:exe": "npm run dist"
  },
  "dependencies": {
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/noto-serif-hebrew": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@material-design-icons/svg": "^0.14.15",
    "pdfjs-dist": "^6.5.438"
  },
  "build": {
    "appId": "com.shoso.books",
    "productName": "SHOSO Books",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json",
      "!**/*.map",
      "!**/node_modules/pdfjs-dist/**",
      "!**/node_modules/@fontsource/**",
      "!**/node_modules/@material-design-icons/**",
      "!**/node_modules/react/**",
      "!**/node_modules/react-dom/**",
      "!**/node_modules/.bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SHOSO-Books-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SHOSO Books",
      "artifactName": "SHOSO-Books-Setup-${version}.${ext}"
    },
    "publish": null,
    "portable": {
      "artifactName": "SHOSO-Books-Portable-${version}.${ext}"
    },
    "electronLanguages": [
      "he",
      "en-US"
    ],
    "compression": "maximum",
    "asar": true,
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB Book",
        "description": "ספר אלקטרוני (EPUB)",
        "role": "Viewer",
        "icon": "icon.ico"
      },
      {
        "ext": "fb2",
        "name": "FictionBook",
        "description": "ספר אלקטרוני (FB2)",
        "role": "Viewer",
        "icon": "icon.ico"
      },
      {
        "ext": "mobi",
        "name": "Mobipocket Book",
        "description": "ספר אלקטרוני (MOBI)",
        "role": "Viewer",
        "icon": "icon.ico"
      },
      {
        "ext": "azw3",
        "name": "Kindle Book",
        "description": "ספר אלקטרוני (AZW3)",
        "role": "Viewer",
        "icon": "icon.ico"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "מסמך PDF",
        "role": "Viewer",
        "icon": "icon.ico"
      }
    ]
  }
}

{
  "name": "shoso-music",
  "productName": "SHOSO Music",
  "version": "1.0.0",
  "description": "SHOSO Music - נגן מוזיקה שולחני לווינדוס (Windows only)",
  "author": "SHOSO",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "preview:web": "vite preview --host 0.0.0.0 --port 4173",
    "build:web": "vite build",
    "start:app": "npm run build:web && electron .",
    "app": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build:web && electron-builder --win nsis portable",
    "dist:portable": "npm run build:web && electron-builder --win portable",
    "build:exe": "npm run dist"
  },
  "dependencies": {
    "music-metadata": "7.14.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.shoso.music",
    "productName": "SHOSO Music",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "SHOSO-Music-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SHOSO Music"
    }
  }
}

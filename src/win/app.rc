// SHOSO Music - resources: icon, manifest, version info
#include <windows.h>

#define IDI_APP 101

IDI_APP ICON "resources/app.ico"
1 24 "resources/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040d04b0"
    BEGIN
      VALUE "CompanyName", "SHOSO"
      VALUE "FileDescription", "SHOSO Music - local music player"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "SHOSO-Music"
      VALUE "LegalCopyright", "SHOSO"
      VALUE "OriginalFilename", "SHOSO-Music.exe"
      VALUE "ProductName", "SHOSO Music"
      VALUE "ProductVersion", "1.0.0.0"
    END
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "SHOSO"
      VALUE "FileDescription", "SHOSO Music - local music player"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "SHOSO-Music"
      VALUE "LegalCopyright", "SHOSO"
      VALUE "OriginalFilename", "SHOSO-Music.exe"
      VALUE "ProductName", "SHOSO Music"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x40d, 1200, 0x409, 1200
  END
END
